# Zavu (mensajería Telegram)
# Alta desde el portal del Buildathon → "Mis créditos"
# ZAVU_API_KEY=

# Canal de envío (este proyecto usa telegram)
ZAVU_CHANNEL=telegram

# Sender de Zavu con Telegram activo
# ZAVU_SENDER_ID=

# Webhook del Sender (Dashboard Zavu → Sender → Webhooks)
# ZAVU_WEBHOOK_SECRET=
# Token alternativo: ?token=... en la URL del webhook
# ZAVU_WEBHOOK_TOKEN=

# Bot de Telegram (@BotFather) conectado al sender de Zavu
# TELEGRAM_BOT_TOKEN=

# Usuario público del bot, sin @. Para el deep link de conexión
# TELEGRAM_BOT_USERNAME=

# Chat ID de prueba para scripts/test-zavu.ts (número, no teléfono)
# TEST_PHONE=

# URL pública del API (links en mensajes)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Google Gemini (RAG /api/ask)
AI_PROVIDER=google
# GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.1-flash-lite

# Exa — refuerzo web de buscar_normativa (solo impuestos.gob.bo)
# Sin key el RAG usa solo el corpus local
# EXA_API_KEY=

# CORS opcional: orígenes permitidos, separados por comas
# Sin definir, queda abierto (*)
# ALLOWED_ORIGINS=https://tu-app.netlify.app,http://localhost:5173

# Google Calendar API (solo para la tool MCP agregar_a_google_calendar)
# Ver backend/mcp/README.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
