# Zavu (mensajeria Telegram) - opcional por ahora; sin ella el API arranca igual
# Alta desde el portal del Buildathon -> "Mis creditos"
# ZAVU_API_KEY=

# Canal de envio: telegram (por defecto), sms o whatsapp.
ZAVU_CHANNEL=telegram

# Opcional: sender especifico de Zavu. Si se omite, usa el default del proyecto.
ZAVU_SENDER_ID=

# Secreto del webhook del Sender (Dashboard Zavu → Sender → Webhooks).
# Sin este valor el endpoint /api/zavu/webhook acepta eventos sin verificar firma (solo local).
# ZAVU_WEBHOOK_SECRET=
# Token alternativo para autenticar webhooks mediante ?token=... (útil con túneles locales).
# ZAVU_WEBHOOK_TOKEN=

# Token del bot de Telegram (@BotFather). Conectar con:
#   curl -X POST https://api.zavu.dev/v1/senders/$ZAVU_SENDER_ID/telegram \
#     -H "Authorization: Bearer $ZAVU_API_KEY" -H "Content-Type: application/json" \
#     -d '{"botToken":"..."}'
# TELEGRAM_BOT_TOKEN=

# Usuario público del bot, sin @. Se usa para abrir el enlace de conexión.
# TELEGRAM_BOT_USERNAME=

# Chat ID de Telegram de prueba para scripts/test-zavu.ts (numero, no telefono)
TEST_PHONE=

# URL publica de la app (para links de descarga en el mensaje)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Proveedor de IA: google (rápido/remoto) u ollama (local).
AI_PROVIDER=google
# GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.1-flash-lite

# Ollama (alternativa local) - defaults: http://127.0.0.1:11434 y qwen2.5:7b
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# Exa (sponsor) - fallback web de buscar_normativa restringido a impuestos.gob.bo
# Sin key el RAG funciona 100% local. Activar en el portal -> "Mis creditos"
# EXA_API_KEY=
