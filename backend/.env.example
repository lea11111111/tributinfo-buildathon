# Zavu (mensajeria WhatsApp) - se obtiene del dashboard de Zavu
# Alta desde el portal del Buildathon -> "Mis creditos"
ZAVU_API_KEY=

# Opcional: sender especifico de Zavu. Si se omite, usa el default del proyecto.
ZAVU_SENDER_ID=

# Numero de prueba del equipo para scripts/test-zavu.ts (formato +591XXXXXXXX)
TEST_PHONE=

# URL publica de la app (para links de descarga en el mensaje de WhatsApp)
NEXT_PUBLIC_APP_URL=http://localhost:3000
