# Zavu (mensajeria WhatsApp) - opcional por ahora; sin ella el API arranca igual
# Alta desde el portal del Buildathon -> "Mis creditos"
# ZAVU_API_KEY=

# Canal de envio: sms (por defecto) o whatsapp.
ZAVU_CHANNEL=sms

# Opcional: sender especifico de Zavu. Si se omite, usa el default del proyecto.
ZAVU_SENDER_ID=

# Numero de prueba del equipo para scripts/test-zavu.ts (formato +591XXXXXXXX)
TEST_PHONE=

# URL publica de la app (para links de descarga en el mensaje de WhatsApp)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ollama (RAG local) - defaults: http://127.0.0.1:11434 y qwen2.5:7b
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# Exa (sponsor) - fallback web de buscar_normativa restringido a impuestos.gob.bo
# Sin key el RAG funciona 100% local. Activar en el portal -> "Mis creditos"
# EXA_API_KEY=
